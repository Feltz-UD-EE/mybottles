<main class="page-section">
  <div class="page-header">
    <h1>Edit Appellation Grape</h1>
    <%= link_to "Back to region", region_path(@appellation_grape.appellation), class: "button" %>
  </div>

  <%= render "shared/errors", resource: @appellation_grape %>

  <%= form_with model: @appellation_grape, class: "resource-form" do |form| %>
    <%= form.hidden_field :appellation_id %>

    <div class="field">
      <%= form.label :grape_id, "Grape" %>
      <%= form.collection_select :grape_id, Grape.visible_to(current_user).order(:name), :id, :selection_name %>
    </div>

    <div class="field">
      <%= form.label :notes %>
      <%= form.text_field :notes %>
    </div>

    <div class="form-actions">
      <%= form.submit "Save", class: "button button--primary" %>
    </div>
  <% end %>

  <div class="related-actions">
    <%= button_to "Delete", @appellation_grape, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Delete this appellation grape?" } } %>
  </div>
</main>

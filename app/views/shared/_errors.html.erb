<% if resource.errors.any? %>
  <div class="error-messages">
    <h2><%= pluralize(resource.errors.count, "error") %> prevented this record from being saved</h2>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<header class="site-header" data-controller="menu">
  <div class="site-header__inner">
    <%= link_to root_path, class: "site-logo", aria: { label: "My Bottles home" } do %>
      <%= image_tag "my_bottles_mark.svg", class: "site-logo__mark", alt: "" %>
      <span class="site-logo__text">My Bottles</span>
    <% end %>

    <button class="menu-toggle" type="button" data-action="menu#toggle" data-menu-target="button" aria-controls="primary-menu" aria-expanded="false">
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
      <span class="visually-hidden">Open menu</span>
    </button>

    <nav id="primary-menu" class="primary-menu" data-menu-target="panel" aria-label="Main menu">
      <ul class="primary-menu__list">
        <li class="primary-menu__item primary-menu__item--has-children">
          <a class="primary-menu__link" href="#" data-action="click->menu#ignorePlaceholder">Cellars</a>
          <ul class="primary-menu__submenu" aria-label="Cellars submenu">
            <li><%= link_to "Cellars", cellars_path, class: "primary-menu__link" %></li>
            <li><%= link_to "Bins", bins_path, class: "primary-menu__link" %></li>
            <li><%= link_to "Bays", bays_path, class: "primary-menu__link" %></li>
            <li><%= link_to "Shelves", shelves_path, class: "primary-menu__link" %></li>
          </ul>
        </li>
        <li class="primary-menu__item"><%= link_to "Watch List", watch_list_entries_path, class: "primary-menu__link" %></li>
        <li class="primary-menu__item primary-menu__item--has-children">
          <a class="primary-menu__link" href="#" data-action="click->menu#ignorePlaceholder">Clubs</a>
          <ul class="primary-menu__submenu" aria-label="Clubs submenu">
            <li><%= link_to "Current", wine_clubs_path, class: "primary-menu__link" %></li>
            <li><%= link_to "All", all_wine_clubs_path, class: "primary-menu__link" %></li>
            <li><%= link_to "New", new_wine_club_path, class: "primary-menu__link" %></li>
          </ul>
        </li>
        <li class="primary-menu__item primary-menu__item--has-children">
          <a class="primary-menu__link" href="#" data-action="click->menu#ignorePlaceholder">Data</a>
          <ul class="primary-menu__submenu" aria-label="Data submenu">
            <li><%= link_to "Producers", producers_path, class: "primary-menu__link" %></li>
            <li><%= link_to "Wines", wines_path, class: "primary-menu__link" %></li>
            <li><%= link_to "Vintages", vintages_path, class: "primary-menu__link" %></li>
            <li><%= link_to "Bottles", bottles_path, class: "primary-menu__link" %></li>
            <li><%= link_to "Tasting Notes", tasting_notes_path, class: "primary-menu__link" %></li>
          </ul>
        </li>
      </ul>

      <button class="theme-toggle" type="button" data-action="theme#toggle" data-theme-target="button" aria-pressed="false">
        <span data-theme-target="label">Dark mode</span>
      </button>

      <button class="theme-toggle" type="button" data-controller="label-printing" data-action="label-printing#toggle" data-label-printing-target="button" data-label-printing-preference-key-value="my-bottles-print-labels" aria-pressed="false">
        <span data-label-printing-target="label">Print labels</span>
      </button>
    </nav>
  </div>
</header>

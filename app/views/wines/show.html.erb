<main class="page-section">
  <div class="page-header">
    <h1><%= @wine.producer.name %> - <%= @wine.name %> <%= community_status_tag(@wine) %> <%= pending_edit_tag(@wine) %></h1>
    <div class="actions">
      <%= link_to "Add to Watch List", new_watch_list_entry_path(watch_list_entry: { watchable_type: "Wine", watchable_id: @wine.id }), class: "button button--primary" %>
      <%= link_to "Edit", edit_wine_path(@wine) %>
      <%= link_to "Back to wines", wines_path %>
      <%= button_to "Delete", @wine, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Delete this wine?" } } %>
    </div>
  </div>

  <dl class="resource-details">
    <dt>Producer</dt>
    <dd><%= link_to @wine.producer.name, @wine.producer %></dd>
    <dt>Description</dt>
    <dd><%= simple_format(@wine.description) %></dd>
    <dt>Style</dt>
    <dd><%= @wine.style %></dd>
    <dt>Color</dt>
    <dd><%= @wine.color %></dd>
    <dt>Appellation</dt>
    <dd><%= @wine.appellation %></dd>
    <dt>Average rating</dt>
    <dd><%= rating_circles(@average_rating, title: number_with_precision(@average_rating, precision: 2), label: "Average rating #{number_with_precision(@average_rating, precision: 2)} out of 5") if @average_rating.present? %></dd>
  </dl>

  <section class="related-section">
    <h2>Bottles Purchased by Vintage</h2>

    <div class="table-wrapper">
      <table class="data-table data-table--compact">
        <thead>
          <tr>
            <th>Vintage</th>
            <th>Bottles purchased</th>
            <th>Bottles on hand</th>
          </tr>
        </thead>
        <tbody>
          <% @vintages.each do |vintage| %>
            <tr>
              <td><%= link_to vintage.vintage, vintage %> <%= community_status_tag(vintage) %></td>
              <td><%= vintage.bottles.size %></td>
              <td><%= vintage.bottles.count(&:in_inventory?) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="related-actions">
      <%= link_to "New Vintage", new_vintage_path(vintage: { wine_id: @wine.id }), class: "button button--primary" %>
    </div>
  </section>

  <%= render "tasting_notes/related_table", tasting_notes: @tasting_notes, show_vintage: true %>
</main>

<%= form_with(model: wine, class: "resource-form") do |form| %>
  <%= render "shared/errors", resource: wine %>

  <div class="field">
    <%= form.label :producer_id, "Producer" %>
    <% if wine.persisted? %>
      <p><%= link_to wine.producer.name, wine.producer %></p>
      <%= form.hidden_field :producer_id %>
    <% else %>
      <%= form.collection_select :producer_id, Producer.order(:name), :id, :name, { prompt: "Select a producer" }, required: true %>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div class="field">
    <%= form.label :style %>
    <%= form.select :style, options_for_select(Wine::STYLES, wine.style), { include_blank: true } %>
  </div>

  <div class="field">
    <%= form.label :color %>
    <%= form.select :color, options_for_select(Wine::COLORS, wine.color), { include_blank: true } %>
  </div>

  <div class="field">
    <%= form.label :appellation %>
    <%= form.text_field :appellation %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
  </div>
<% end %>

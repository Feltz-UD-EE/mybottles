<main class="page-section">
  <div class="page-header">
    <h1><%= @bay.display_name %></h1>
    <div class="actions">
      <%= link_to "Edit", edit_bay_path(@bay) %>
      <%= link_to "Back to bays", bays_path %>
      <%= button_to "Delete", @bay, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Delete this bay?" } } %>
    </div>
  </div>

  <dl class="resource-details">
    <dt>Cellar</dt>
    <dd><%= link_to @bay.cellar.name, @bay.cellar %></dd>
    <dt>Label</dt>
    <dd><%= @bay.label %></dd>
    <dt>Location</dt>
    <dd><%= @bay.location %></dd>
    <dt>Bottles stored</dt>
    <dd><%= @bay.current_bottle_count %></dd>
    <dt>Notes</dt>
    <dd><%= simple_format(@bay.notes) %></dd>
  </dl>

  <section class="related-section">
    <div class="related-section__header">
      <h2>Shelves</h2>
      <%= link_to "New Shelf", new_shelf_path(shelf: { shelveable_type: "Bay", shelveable_id: @bay.id }), class: "button button--primary" %>
    </div>
    <div class="table-wrapper">
      <table class="data-table data-table--compact">
        <thead>
          <tr>
            <th>Number</th>
            <th>Label</th>
            <th>Bottles stored</th>
          </tr>
        </thead>
        <tbody>
          <% @shelves.each do |shelf| %>
            <tr>
              <td><%= link_to shelf.number, shelf %></td>
              <td><%= shelf.label %></td>
              <td><%= shelf.current_bottle_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>

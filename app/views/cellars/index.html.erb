<main class="page-section">
  <div class="page-header">
    <h1>Cellars</h1>
    <%= link_to "New cellar", new_cellar_path, class: "button button--primary" %>
  </div>

  <section data-controller="table" data-table-per-page-value="25">
    <div class="table-toolbar">
      <label for="cellar-search">Search cellars</label>
      <input id="cellar-search" class="table-search" type="search" data-table-target="query" data-action="input->table#search">
    </div>

    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><button type="button" data-action="table#sort" data-table-column="name">Name</button></th>
            <th>Location</th>
            <th>Bottles stored</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @cellars.each do |cellar| %>
            <tr data-table-target="row">
              <td data-table-sort-value="name"><%= link_to cellar.name, cellar %></td>
              <td><%= cellar.location %></td>
              <td><%= cellar.current_bottle_count %></td>
              <td class="actions"><%= link_to "Edit", edit_cellar_path(cellar) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="empty-state"><%= "No cellars yet." if @cellars.empty? %></p>

    <div class="table-pagination">
      <button class="button" type="button" data-table-target="previousButton" data-action="table#previousPage">Previous</button>
      <span data-table-target="pageLabel">Page 1</span>
      <button class="button" type="button" data-table-target="nextButton" data-action="table#nextPage">Next</button>
    </div>
  </section>
</main>

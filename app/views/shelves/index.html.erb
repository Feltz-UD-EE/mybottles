<main class="page-section">
  <div class="page-header">
    <h1>Shelves</h1>
    <%= link_to "New shelf", new_shelf_path, class: "button button--primary" %>
  </div>

  <section data-controller="table" data-table-per-page-value="25">
    <div class="table-toolbar">
      <label for="shelf-search">Search shelves</label>
      <input id="shelf-search" class="table-search" type="search" data-table-target="query" data-action="input->table#search">
    </div>

    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><button type="button" data-action="table#sort" data-table-column="location">Location</button></th>
            <th>Number</th>
            <th>Label</th>
            <th>Depth</th>
            <th>Bottles stored</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @shelves.each do |shelf| %>
            <tr data-table-target="row">
              <td data-table-sort-value="location"><%= link_to shelf.location_name, shelf %></td>
              <td><%= shelf.number %></td>
              <td><%= shelf.label %></td>
              <td><%= shelf.depth %></td>
              <td><%= shelf.current_bottle_count %></td>
              <td class="actions"><%= link_to "Edit", edit_shelf_path(shelf) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="empty-state"><%= "No shelves yet." if @shelves.empty? %></p>

    <div class="table-pagination">
      <button class="button" type="button" data-table-target="previousButton" data-action="table#previousPage">Previous</button>
      <span data-table-target="pageLabel">Page 1</span>
      <span class="table-row-count" data-table-target="rowCount"></span>
      <button class="button" type="button" data-table-target="nextButton" data-action="table#nextPage">Next</button>
    </div>
  </section>
</main>

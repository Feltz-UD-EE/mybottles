<%= form_with(model: tasting_note, class: "resource-form tasting-note-form", data: { controller: "tasting-note" }) do |form| %>
  <%= render "shared/errors", resource: tasting_note %>

  <% if tasting_note.tasteable.is_a?(Bottle) %>
    <section class="form-panel">
      <h2>Bottle</h2>
      <p><%= link_to tasting_note.tasteable_name, tasting_note.tasteable %></p>
      <% if tasting_note.tasteable.list_price.present? %>
        <p>List price: <%= number_to_currency(tasting_note.tasteable.list_price) %></p>
      <% end %>
      <%= hidden_field_tag "tasting_note[tasteable_type]", "Bottle" %>
      <%= hidden_field_tag "tasting_note[tasteable_id]", tasting_note.tasteable.id %>
    </section>
  <% elsif tasting_note.persisted? && tasting_note.tasteable.present? %>
    <section class="form-panel">
      <h2>Wine</h2>
      <p><%= link_to tasting_note.tasteable_name, tasting_note.tasteable %></p>
      <%= hidden_field_tag "tasting_note[tasteable_type]", tasting_note.tasteable_type %>
      <%= hidden_field_tag "tasting_note[tasteable_id]", tasting_note.tasteable_id %>
    </section>
  <% else %>
    <section class="form-panel">
      <h2>Wine</h2>
      <%= hidden_field_tag "tasting_note[tasteable_type]", "Vintage" %>
      <%= hidden_field_tag "tasting_note[tasteable_id]", tasting_note.tasteable_id, data: { tasting_note_target: "tasteableId" } %>

      <div>
        <div class="field field-with-action">
          <div class="field">
            <%= label_tag "tasting_note_vintage_lookup", "Find a wine or vintage" %>
            <%= text_field_tag "tasting_note[vintage_lookup]", tasting_note.tasteable&.display_name,
                  autocomplete: "off", maxlength: 120, placeholder: "Producer, wine, or vintage",
                  data: { tasting_note_target: "vintageInput", search_url: search_vintages_path,
                          action: "input->tasting-note#queueVintageSearch keydown.enter->tasting-note#focusVintageResults:prevent keydown.down->tasting-note#focusVintageResults:prevent" } %>
          </div>
          <button class="button" type="button" aria-controls="new-wine-fields" aria-expanded="false"
                  data-tasting-note-target="newWineButton" data-action="tasting-note#showNewWine">New wine</button>
        </div>
        <div class="vintage-search-status" role="status" data-tasting-note-target="vintageStatus"></div>
        <ul class="vintage-search-results" aria-label="Matching vintages" data-tasting-note-target="vintageResults"></ul>
      </div>

      <fieldset id="new-wine-fields" class="inline-fields" data-tasting-note-target="newWineFields" hidden disabled>
        <div class="field">
          <%= label_tag "new_wine_producer_name", "Producer" %>
          <%= text_field_tag "new_wine[producer_name]" %>
        </div>
        <div class="field">
          <%= label_tag "new_wine_wine_name", "Wine" %>
          <%= text_field_tag "new_wine[wine_name]" %>
        </div>
        <div class="field">
          <%= label_tag "new_wine_vintage", "Vintage" %>
          <%= text_field_tag "new_wine[vintage]", nil, placeholder: "(year, batch, or NV)" %>
        </div>
        <div class="field">
          <%= label_tag "new_wine_appellation", "Appellation" %>
          <%= text_field_tag "new_wine[appellation]" %>
        </div>
        <div class="field">
          <%= label_tag "new_wine_grapes", "Grapes" %>
          <%= text_area_tag "new_wine[grapes]" %>
        </div>
      </fieldset>
    </section>
  <% end %>

  <div class="field">
    <%= form.label :date %>
    <%= form.date_field :date, required: true %>
  </div>

  <div class="field">
    <%= form.label :setting %>
    <%= form.text_field :setting %>
  </div>

  <div class="field">
    <%= form.label :temperature %>
    <%= form.text_field :temperature %>
  </div>

  <div class="field">
    <%= form.label :pairing %>
    <%= form.text_field :pairing %>
  </div>

  <div class="field">
    <%= form.label :color %>
    <%= form.text_field :color %>
  </div>

  <div class="field">
    <%= form.label :nose %>
    <%= form.text_area :nose %>
  </div>

  <div class="field">
    <%= form.label :palate %>
    <%= form.text_area :palate %>
  </div>

  <div class="field">
    <%= form.label :overall %>
    <%= form.text_area :overall %>
  </div>

  <div class="field">
    <%= form.label :rating %>
    <div class="rating-slider">
      <%= form.range_field :rating, min: 0, max: 5, step: 0.25, value: tasting_note.rating || 0, data: { tasting_note_target: "ratingInput", action: "input->tasting-note#updateRating" } %>
      <output data-tasting-note-target="ratingOutput"><%= number_with_precision(tasting_note.rating || 0, precision: 2, strip_insignificant_zeros: true) %></output>
    </div>
  </div>

  <div class="field">
    <span class="field-label">Buy</span>
    <div class="buy-choice-group">
      <label class="buy-choice buy-choice--yes">
        <%= form.check_box :buy_yes, { checked: tasting_note.buy_yes_selected? }, "1", "0" %>
        <span>Yes</span>
      </label>
      <label class="buy-choice buy-choice--no">
        <%= form.check_box :buy_no, { checked: tasting_note.buy_no_selected? }, "1", "0" %>
        <span>No</span>
      </label>
    </div>
  </div>

  <div class="form-actions">
    <% if tasting_note.tasteable.is_a?(Bottle) %>
      <button class="button button--primary" type="submit" name="finish_action" value="done">Save</button>
    <% else %>
      <button class="button button--primary" type="submit" name="finish_action" value="done">Done Tasting</button>
      <button class="button" type="submit" name="finish_action" value="taste_another">Taste Another</button>
    <% end %>
  </div>
<% end %>

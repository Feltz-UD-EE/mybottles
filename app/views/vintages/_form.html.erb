<%= form_with(model: vintage, class: "resource-form") do |form| %>
  <%= render "shared/errors", resource: vintage %>

  <div class="field">
    <%= form.label :vintage %>
    <%= form.text_field :vintage, required: true, placeholder: "(year, batch, or NV)" %>
  </div>

  <div class="field">
    <%= form.label :wine_id, "Wine" %>
    <%= form.collection_select :wine_id, Wine.includes(:producer).order(:name), :id, :to_s, { prompt: "Select a wine" }, required: true %>
  </div>

  <div class="field">
    <%= form.label :grapes %>
    <%= form.text_area :grapes %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
  </div>
<% end %>

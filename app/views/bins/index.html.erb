<main class="page-section">
  <div class="page-header">
    <h1>Bins</h1>
    <%= link_to "New bin", new_bin_path, class: "button button--primary" %>
  </div>

  <section data-controller="table" data-table-per-page-value="25">
    <div class="table-toolbar">
      <label for="bin-search">Search bins</label>
      <input id="bin-search" class="table-search" type="search" data-table-target="query" data-action="input->table#search">
    </div>

    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><button type="button" data-action="table#sort" data-table-column="cellar">Cellar</button></th>
            <th><button type="button" data-action="table#sort" data-table-column="label">Label</button></th>
            <th>Location</th>
            <th>Bottles stored</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @bins.each do |bin| %>
            <tr data-table-target="row">
              <td data-table-sort-value="cellar"><%= link_to bin.cellar.name, bin.cellar %></td>
              <td data-table-sort-value="label"><%= link_to bin.label, bin %></td>
              <td><%= bin.location %></td>
              <td><%= bin.current_bottle_count %></td>
              <td class="actions"><%= link_to "Edit", edit_bin_path(bin) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="empty-state"><%= "No bins yet." if @bins.empty? %></p>

    <div class="table-pagination">
      <button class="button" type="button" data-table-target="previousButton" data-action="table#previousPage">Previous</button>
      <span data-table-target="pageLabel">Page 1</span>
      <span class="table-row-count" data-table-target="rowCount"></span>
      <button class="button" type="button" data-table-target="nextButton" data-action="table#nextPage">Next</button>
    </div>
  </section>
</main>

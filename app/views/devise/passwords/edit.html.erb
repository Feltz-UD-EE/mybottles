<main class="page-section">
  <div class="page-header">
    <h1>Change password</h1>
  </div>

  <%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :put, class: "resource-form" do |form| %>
    <%= form.hidden_field :reset_password_token %>

    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, autofocus: true, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="form-actions">
      <%= form.submit "Save" %>
    </div>
  <% end %>
</main>

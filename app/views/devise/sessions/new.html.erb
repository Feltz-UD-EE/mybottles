<main class="page-section">
  <div class="page-header">
    <h1>Log in</h1>
  </div>

  <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "resource-form" do |form| %>
    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, autocomplete: "current-password" %>
    </div>

    <div class="field checkbox-field">
      <%= form.check_box :remember_me %>
      <%= form.label :remember_me %>
    </div>

    <div class="form-actions">
      <%= form.submit "Log in" %>
    </div>
  <% end %>

  <p><%= link_to "Forgot your password?", new_password_path(resource_name) %></p>
</main>

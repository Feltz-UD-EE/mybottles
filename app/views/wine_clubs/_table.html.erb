<section data-controller="table" data-table-per-page-value="25">
  <div class="table-toolbar">
    <label for="<%= all ? "all-wine-club-search" : "wine-club-search" %>">Search clubs</label>
    <input id="<%= all ? "all-wine-club-search" : "wine-club-search" %>" class="table-search" type="search" data-table-target="query" data-action="input->table#search">
  </div>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th><button type="button" data-action="table#sort" data-table-column="producer">Producer</button></th>
          <th><button type="button" data-action="table#sort" data-table-column="tier">Tier</button></th>
          <th>Size</th>
          <th>Schedule</th>
          <th>Delivery</th>
          <th>Discount</th>
          <% if all %>
            <th>Current</th>
          <% end %>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% wine_clubs.each do |wine_club| %>
          <tr data-table-target="row">
            <td data-table-sort-value="producer"><%= link_to wine_club.producer.name, wine_club.producer %></td>
            <td data-table-sort-value="tier"><%= link_to wine_club.tier, wine_club %></td>
            <td><%= wine_club.size %></td>
            <td><%= wine_club.schedule %></td>
            <td><%= wine_club.delivery_method %></td>
            <td><%= "#{wine_club.discount}%" if wine_club.discount.present? %></td>
            <% if all %>
              <td><%= wine_club.current_member? ? "Yes" : "No" %></td>
            <% end %>
            <td class="actions">
              <%= link_to "Edit", edit_wine_club_path(wine_club) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <p class="empty-state"><%= "No wine clubs yet." if wine_clubs.empty? %></p>

  <div class="table-pagination">
    <button class="button" type="button" data-table-target="previousButton" data-action="table#previousPage">Previous</button>
    <span data-table-target="pageLabel">Page 1</span>
    <button class="button" type="button" data-table-target="nextButton" data-action="table#nextPage">Next</button>
  </div>
</section>

<%= form_with(model: wine_club, class: "resource-form", data: { controller: "wine-club" }) do |form| %>
  <%= render "shared/errors", resource: wine_club %>

  <div class="field field-with-action">
    <div>
      <%= form.label :producer_id, "Producer" %>
      <%= form.collection_select :producer_id, @producers, :id, :name, { include_blank: true }, { required: true, data: { wine_club_target: "producerSelect" } } %>
    </div>
    <button class="button" type="button" data-action="wine-club#showNewProducer">New Producer</button>
  </div>

  <div class="inline-fields" data-wine-club-target="newProducerFields" hidden>
    <div class="field">
      <%= label_tag "new_producer_name", "Name" %>
      <%= text_field_tag "new_producer[name]" %>
    </div>
    <div class="field">
      <%= label_tag "new_producer_address", "Address" %>
      <%= text_area_tag "new_producer[address]" %>
    </div>
    <div class="field">
      <%= label_tag "new_producer_email", "Email" %>
      <%= email_field_tag "new_producer[email]" %>
    </div>
    <div class="field">
      <%= label_tag "new_producer_website", "Website" %>
      <%= url_field_tag "new_producer[website]", nil, placeholder: "https://example.com" %>
    </div>
    <div class="field">
      <%= label_tag "new_producer_phone", "Phone" %>
      <%= telephone_field_tag "new_producer[phone]" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :tier %>
    <%= form.text_field :tier %>
  </div>

  <div class="field">
    <%= form.label :size %>
    <%= form.number_field :size, required: true %>
  </div>

  <div class="field">
    <%= form.label :schedule %>
    <%= form.text_field :schedule, required: true %>
  </div>

  <div class="field">
    <%= form.label :delivery_method %>
    <%= form.select :delivery_method, options_for_select(WineClub::DELIVERY_METHODS, wine_club.delivery_method), { include_blank: true } %>
  </div>

  <div class="field">
    <%= form.label :payment_method %>
    <%= form.text_field :payment_method %>
  </div>

  <div class="field">
    <%= form.label :discount %>
    <%= form.number_field :discount, min: 0, max: 100, step: "0.01" %>
  </div>

  <div class="field">
    <%= form.label :date_joined %>
    <%= form.date_field :date_joined %>
  </div>

  <div class="field">
    <%= form.label :date_left %>
    <%= form.date_field :date_left %>
  </div>

  <div class="field">
    <%= form.label :member_id, "Member ID" %>
    <%= form.text_field :member_id %>
  </div>

  <div class="field">
    <%= form.label :benefits %>
    <%= form.text_area :benefits %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button button--primary" %>
  </div>
<% end %>

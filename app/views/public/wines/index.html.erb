<main class="page-section">
  <div class="page-header">
    <h1>Wines</h1>
  </div>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Producer</th>
          <th>Wine</th>
          <th>Style</th>
          <th>Color</th>
          <th>Appellation</th>
        </tr>
      </thead>
      <tbody>
        <% @wines.each do |wine| %>
          <tr>
            <td><%= link_to wine.producer.name, public_producer_path(wine.producer) %></td>
            <td><%= link_to wine.name, public_wine_path(wine) %></td>
            <td><%= wine.style %></td>
            <td><%= wine.color %></td>
            <td><%= wine.appellation %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>

<div class="table-wrapper">
  <table class="data-table data-table--compact">
    <thead>
      <tr>
        <th>Inventory</th>
        <th>Wine</th>
        <th>Purchase date</th>
        <th>Source</th>
        <th>Location</th>
      </tr>
    </thead>
    <tbody>
      <% bottles.each do |bottle| %>
        <tr>
          <td><%= link_to bottle.inventory_code, bottle %></td>
          <td><%= link_to bottle.display_name, bottle.vintage %></td>
          <td><%= bottle.purchase_date&.iso8601 %></td>
          <td><%= bottle.purchase_source %></td>
          <td><%= bottle.location_name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="empty-state"><%= empty_message if bottles.empty? %></p>

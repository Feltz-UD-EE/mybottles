<main class="page-section">
  <div class="page-header">
    <h1>Disposed Bottles</h1>
    <div class="page-actions">
      <%= link_to "Back to bottles", bottles_path, class: "button" %>
    </div>
  </div>

  <section data-controller="table" data-table-per-page-value="25">
    <div class="table-toolbar">
      <label for="bottle-search">Search bottles</label>
      <input id="bottle-search" class="table-search" type="search" data-table-target="query" data-action="input->table#search">

      <%= form_with url: disposed_bottles_path, method: :get, local: true, class: "table-filter-form" do %>
        <%= label_tag :disposal_method, "Disposal method" %>
        <%= select_tag :disposal_method,
          options_for_select([ [ "All", "" ] ] + Bottle::DISPOSAL_METHODS.map { |method| [ method, method ] }, @disposal_method),
          onchange: "this.form.requestSubmit()" %>
      <% end %>
    </div>

    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><button type="button" data-action="table#sort" data-table-column="inventory">Inventory</button></th>
            <th><button type="button" data-action="table#sort" data-table-column="wine">Wine</button></th>
            <th>Purchase Date</th>
            <th>Source</th>
            <th>List Price</th>
            <th>Discount Price</th>
            <th>Disposal Date</th>
            <th>Disposal Method</th>
            <th>Tasted</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @bottles.each do |bottle| %>
            <tr data-table-target="row">
              <td data-table-sort-value="inventory"><%= bottle.inventory_code %></td>
              <td data-table-sort-value="wine">
                <%= link_to "#{bottle.vintage.wine.producer.name} - #{bottle.vintage.wine.name} - #{bottle.vintage.vintage}", bottle.vintage %>
              </td>
              <td><%= bottle.purchase_date&.iso8601 %></td>
              <td><%= bottle.purchase_source %></td>
              <td><%= number_to_currency(bottle.list_price) if bottle.list_price.present? %></td>
              <td><%= number_to_currency(bottle.discount_price) if bottle.discount_price.present? %></td>
              <td><%= bottle.disposal_date&.iso8601 %></td>
              <td><%= bottle.disposal_method %></td>
              <td><%= tasted_checkmark if @tasted_bottle_ids.include?(bottle.id) %></td>
              <td class="actions">
                <%= link_to "Add to Watch List", new_watch_list_entry_path(watch_list_entry: { watchable_type: "Vintage", watchable_id: bottle.vintage_id }) %>
                <%= link_to "Tasted This", new_tasting_note_path(tasting_note: { tasteable_type: "Bottle", tasteable_id: bottle.id }) %>
                <%= link_to "Show", bottle %>
                <%= link_to "Edit", edit_bottle_path(bottle) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="empty-state"><%= "No disposed bottles." if @bottles.empty? %></p>

    <div class="table-pagination">
      <button class="button" type="button" data-table-target="previousButton" data-action="table#previousPage">Previous</button>
      <span data-table-target="pageLabel">Page 1</span>
      <span class="table-row-count" data-table-target="rowCount"></span>
      <button class="button" type="button" data-table-target="nextButton" data-action="table#nextPage">Next</button>
    </div>
  </section>
</main>

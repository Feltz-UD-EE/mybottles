<%= form_with(model: region, url: region.persisted? ? region_path(region) : regions_path, scope: :appellation, class: "resource-form") do |form| %>
  <%= render "shared/errors", resource: region %>

  <div class="field">
    <%= form.label :country_id, "Country" %>
    <%= form.collection_select :country_id, @countries, :id, :name, { prompt: "Select a country" }, required: true %>
  </div>

  <div class="field">
    <%= form.label :parent_id, "Parent region" %>
    <%= form.collection_select :parent_id, @parent_regions, :id, :path_name, { include_blank: true } %>
  </div>

  <div class="field">
    <%= form.label :name, "Region name" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= form.label :degree %>
    <%= form.text_field :degree %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <div class="field checkbox-field">
    <%= form.check_box :auto_generated %>
    <%= form.label :auto_generated, "Auto-generated" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Save", class: "button button--primary" %>
  </div>
<% end %>

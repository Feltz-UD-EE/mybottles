<main class="page-section">
  <div class="page-header">
    <h1>Grapes</h1>
    <%= link_to "New grape", new_grape_path, class: "button button--primary" %>
  </div>

  <section data-controller="table" data-table-per-page-value="25">
    <div class="table-toolbar">
      <label for="grape-search">Search grapes</label>
      <input id="grape-search" class="table-search" type="search" data-table-target="query" data-action="input->table#search">
    </div>

    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><button type="button" data-action="table#sort" data-table-column="name">Name</button></th>
            <th>Synonyms</th>
            <th>Appellations</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @grapes.each do |grape| %>
            <tr data-table-target="row">
              <td data-table-sort-value="name"><%= link_to grape.name, grape %> <%= community_status_tag(grape) %> <%= pending_edit_tag(grape) %></td>
              <td><%= grape.synonym_grapes.count %></td>
              <td><%= grape.allowed_appellations_with_source.count %></td>
              <td class="actions"><%= link_to "Edit", edit_grape_path(grape) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="empty-state"><%= "No grapes yet." if @grapes.empty? %></p>

    <div class="table-pagination">
      <button class="button" type="button" data-table-target="previousButton" data-action="table#previousPage">Previous</button>
      <span data-table-target="pageLabel">Page 1</span>
      <button class="button" type="button" data-table-target="nextButton" data-action="table#nextPage">Next</button>
    </div>
  </section>
</main>

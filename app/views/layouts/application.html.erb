<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Bottles" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_theme_class %>">
    <%= render "shared/header" %>

    <div class="page-shell">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>"><%= message %></div>
      <% end %>

      <% if pending_promotion_event %>
        <aside class="splash">
          <h2>Congratulations</h2>
          <p>You have been promoted to <strong><%= pending_promotion_event.to_trust_level %></strong>.</p>
          <% if pending_promotion_event.to_trust_level == "Curator" %>
            <p>You can now review Producer, Wine, and Vintage submissions, and use User Review to evaluate contributor activity.</p>
            <div class="actions">
              <%= link_to "Review", review_root_path, class: "button button--primary" %>
              <%= link_to "User Review", user_review_root_path, class: "button" %>
            </div>
          <% end %>
          <%= button_to "Dismiss", dismiss_user_trust_event_path(pending_promotion_event), method: :patch, class: "button" %>
        </aside>
      <% end %>

      <%= yield %>
    </div>

    <%= render "shared/footer" %>
  </body>
</html>

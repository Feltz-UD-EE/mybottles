<%= form_with(model: producer, class: "resource-form") do |form| %>
  <%= render "shared/errors", resource: producer %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= form.label :address %>
    <%= form.text_area :address %>
  </div>

  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div class="field">
    <%= form.label :website %>
    <%= form.url_field :website, placeholder: "https://example.com" %>
  </div>

  <div class="field">
    <%= form.label :phone %>
    <%= form.telephone_field :phone %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
  </div>
<% end %>

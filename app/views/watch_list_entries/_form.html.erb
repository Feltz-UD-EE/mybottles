<%= form_with(model: watch_list_entry, class: "resource-form") do |form| %>
  <%= render "shared/errors", resource: watch_list_entry %>

  <% if watch_list_entry.watchable.present? %>
    <section class="form-panel">
      <h2>Wine</h2>
      <p><%= link_to watch_list_entry.watchable_name, watch_list_entry.watchable %></p>
      <%= hidden_field_tag "watch_list_entry[watchable_type]", watch_list_entry.watchable_type %>
      <%= hidden_field_tag "watch_list_entry[watchable_id]", watch_list_entry.watchable_id %>
    </section>
  <% end %>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, required: true %>
  </div>

  <div class="field">
    <%= form.label :quantity %>
    <%= form.text_field :quantity %>
  </div>

  <div class="field">
    <%= form.label :caveat %>
    <%= form.text_area :caveat %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button button--primary" %>
  </div>
<% end %>
